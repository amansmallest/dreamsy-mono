# Copy to .env.local (gitignored). EXPO_PUBLIC_* vars are inlined into the JS bundle;
# the others are read only by app.config.ts at prebuild/build time.
# Restart `npx expo start` after changing this file.

# Platform API (services/api). On a phone use your Mac's LAN IP, not localhost
# (`ipconfig getifaddr en0`). The API binds 0.0.0.0.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8787
# Engine player page (engine-web Vite dev server, `pnpm -C engine-web dev`, port 2005), same LAN IP.
EXPO_PUBLIC_ENGINE_URL=http://192.168.1.10:2005/

# Supabase (Google sign-in). Project URL + publishable key from Supabase → Project Settings → API.
# In Supabase: enable Google under Authentication → Providers, and allow the redirect URLs
# dreamsy://** (builds) and exp://** (Expo Go) under Authentication → URL Configuration.
# services/api needs SUPABASE_URL too (it verifies the Supabase session via the project's JWKS).
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ---- Build-time (app.config.ts) ----

# iOS bundle identifier; must match the App ID in Apple Developer (Sign in with Apple enabled)
# and APPLE_AUDIENCES in services/api/.env.
DREAMSY_IOS_BUNDLE_ID=com.dreamsy.app
# Android package name (not wired up yet; kept sane for later).
DREAMSY_ANDROID_PACKAGE=com.dreamsy.app
