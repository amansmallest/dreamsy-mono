# Copy to .env.local (gitignored). Restart `pnpm -C apps/web dev` after changes.

# Platform API (services/api). Default: http://localhost:8787
VITE_API_URL=http://localhost:8787

# Supabase (same project as the mobile app). Leave VITE_SUPABASE_URL empty to get the
# dev-only "Continue as guest" sign-in (POST /v1/auth/guest) instead.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Mobile deep link base; "Play on phone" QR = ${VITE_APP_DEEPLINK}/game/<id>. Default: dreamsy://
VITE_APP_DEEPLINK=dreamsy://

# Public share page base (DREAMSY.MD §11.5): ${VITE_SHARE_URL}/g/<id>. Default: https://dreamsy.app
VITE_SHARE_URL=https://dreamsy.app
