# Behind Cloudflare (proxied). Serves plain HTTP (Cloudflare SSL "Flexible") and HTTPS with an
# internal cert (SSL "Full"), so either zone setting works.
{
  auto_https disable_redirects
}
# API
http://api.dreamsy.dev, https://api.dreamsy.dev, http://:80 {
  tls internal
  # multiplayer rooms: WebSocket upgrade to the room server (Cloudflare proxies WebSockets)
  handle /rooms* {
    reverse_proxy gameserver:8790
  }
  handle {
    reverse_proxy api:8787 {
      flush_interval -1   # SSE build progress
    }
  }
}
# Engine: the game player for the app's WebView and ?public= share links
http://play.dreamsy.dev, https://play.dreamsy.dev {
  tls internal
  root * /srv/engine
  try_files {path} /index.html
  file_server
}
# Web dashboard (build + edit games; apps/web static build, SPA routes)
http://dreamsy.dev, https://dreamsy.dev, http://www.dreamsy.dev, https://www.dreamsy.dev {
  tls internal
  root * /srv/web
  @assets path /assets/*
  header @assets Cache-Control "public, max-age=31536000, immutable"
  try_files {path} /index.html
  file_server
}
