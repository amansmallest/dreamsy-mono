{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dreamsy:kit/platformer/enemy",
  "title": "platformer enemy (data/enemies/<id>.json)",
  "type": "object",
  "required": ["id", "behaviour"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "Matches the file name and the tile marker tag (tags: [\"enemy\", \"<id>\"])." },
    "name": { "type": "string" },
    "behaviour": { "enum": ["patroller", "hopper", "flyer", "shooter", "chaser", "turret"], "description": "Or a name registered with kit.enemies.define." },
    "sprite": { "type": "string", "pattern": "^asset:[a-z0-9_]+$" },
    "animset": { "type": "string", "pattern": "^data/anims/[a-z0-9_]+\\.json$" },
    "anims": { "type": "object", "description": "state -> animation name: move, idle, attack, hop, chase, patrol", "additionalProperties": { "type": "string" } },
    "color": { "type": "string", "description": "Fill when there is no sprite." },
    "faces": { "enum": ["left", "right"], "default": "right", "description": "Direction the art faces." },
    "size": { "$ref": "#/definitions/vec2", "description": "Hitbox w,h px (bottom-aligned on its marker cell)." },
    "draw_size": { "$ref": "#/definitions/vec2" },
    "hp": { "type": "number", "minimum": 1, "default": 1 },
    "speed": { "type": "number", "minimum": 0, "default": 40 },
    "range": { "type": "number", "description": "patroller: max px from home before turning" },
    "start_dir": { "enum": ["left", "right"] },
    "damage": { "type": "number", "minimum": 0, "default": 1 },
    "gravity": { "type": "number", "minimum": 0, "description": "px/s². Default 1200 (0 for flyer/turret)." },
    "max_fall": { "type": "number" },
    "stompable": { "type": "boolean", "default": true },
    "stomp_damage": { "type": "number" },
    "shootable": { "type": "boolean", "default": true },
    "contact": { "type": "boolean", "default": true, "description": "Touching it hurts the player." },
    "edge_turn": { "type": "boolean", "default": true },
    "knockback": { "type": "boolean", "default": true },
    "score": { "type": "number" },
    "drops": { "enum": ["coin", "heart"] },
    "hop": { "type": "object", "additionalProperties": false, "properties": { "interval": { "type": "number" }, "height": { "type": "number" }, "speed": { "type": "number" }, "toward_player": { "type": "boolean" } } },
    "fly": { "type": "object", "additionalProperties": false, "properties": { "pattern": { "enum": ["sine", "hover", "circle", "swoop"] }, "amplitude": { "type": "number" }, "period": { "type": "number" }, "range": { "type": "number" } } },
    "shoot": { "type": "object", "additionalProperties": false, "properties": {
      "interval": { "type": "number" }, "delay": { "type": "number" }, "speed": { "type": "number" }, "range": { "type": "number" },
      "aim": { "enum": ["player", "facing", "fixed"] }, "angle": { "type": "number", "description": "fixed aim, degrees (0 = right, 90 = down)" },
      "count": { "type": "integer", "minimum": 1 }, "spread": { "type": "number" }, "size": { "$ref": "#/definitions/vec2" },
      "gravity": { "type": "number" }, "life": { "type": "number" }, "los": { "type": "boolean" }, "sprite": { "type": "string" } } },
    "chase": { "type": "object", "additionalProperties": false, "properties": { "range": { "type": "number" }, "jump_height": { "type": "number" }, "speed_mult": { "type": "number" } } }
  },
  "definitions": { "vec2": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 } }
}
