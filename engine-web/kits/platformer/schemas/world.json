{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dreamsy:kit/platformer/world",
  "title": "platformer world structure (data/world.json)",
  "type": "object",
  "required": ["worlds"],
  "additionalProperties": false,
  "properties": {
    "map_scene": { "type": "string", "description": "World map scene (default scenes/world.scene.json); levels return here." },
    "worlds": { "type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["id", "levels"], "additionalProperties": false,
      "properties": {
        "id": { "type": "string" }, "name": { "type": "string" },
        "levels": { "type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["id", "scene"], "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "description": "Stable save key, e.g. \"1-3\"." },
            "name": { "type": "string" }, "short": { "type": "string", "description": "Label under the node." },
            "scene": { "type": "string", "pattern": "^scenes/.+\\.scene\\.json$" },
            "map_pos": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
            "coins": { "type": "integer", "description": "Coin total (shown on the map)." },
            "gems": { "type": "integer", "description": "Gem total (shown on the map, summed for unlocks)." },
            "boss": { "type": "boolean" }, "secret": { "type": "boolean", "description": "Hidden on the map until unlocked; ignored by world rules." },
            "unlock": { "oneOf": [ { "const": "open" }, { "type": "object", "additionalProperties": false, "properties": {
              "after": { "type": "array", "items": { "type": "string" } }, "gems": { "type": "integer" }, "coins": { "type": "integer" },
              "levels": { "type": "integer" }, "ability": { "type": "string" }, "world": { "type": "string" } } } ],
              "description": "Default: previous level (play order) complete." }
          } } }
      } } }
  }
}
