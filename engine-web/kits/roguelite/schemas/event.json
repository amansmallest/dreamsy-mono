{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dreamsy/kits/roguelite/event.json",
  "title": "data/events/<id>.json \u2014 mystery room",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "biomes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "minFloor": {
      "type": "integer"
    },
    "weight": {
      "type": "number"
    },
    "choices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "condition": {
            "description": "core condition (+ roguelite kinds: relic, class, heat, runFloor, hpBelow, runGold, wins, classWins)"
          },
          "cost": {
            "type": "object",
            "properties": {
              "gold": {
                "type": "integer"
              },
              "hp": {
                "type": "integer"
              }
            },
            "additionalProperties": false
          },
          "effects": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "core effects (+ roguelite kinds: heal, healPct, maxHp, gold{raw?}, charge, shield, hurt, relic ('random'|id|{rarity weights}), meta)"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "title",
    "choices"
  ]
}