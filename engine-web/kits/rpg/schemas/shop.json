{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rpg/shop.json",
  "title": "data/shops/<id>.json",
  "description": "A shop opened with the open_shop effect.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          {
            "type": "object",
            "properties": {
              "item": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "price": {
                "type": "integer",
                "minimum": 0
              },
              "if": {
                "$ref": "common.json#/$defs/condition"
              }
            },
            "additionalProperties": false,
            "required": [
              "item"
            ]
          }
        ]
      },
      "minItems": 1
    },
    "sell": {
      "type": "boolean"
    },
    "sell_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "items"
  ]
}
