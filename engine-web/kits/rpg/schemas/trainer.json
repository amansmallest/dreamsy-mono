{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rpg/trainer.json",
  "title": "data/trainers/<id>.json",
  "description": "A trainer (or trial boss). Beating it sets flag beat_<id>.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "portrait": {
      "$ref": "common.json#/$defs/asset"
    },
    "party": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "creature": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "moves": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "maxItems": 4
          },
          "held": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string"
          },
          "genes": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "creature",
          "level"
        ]
      },
      "minItems": 1,
      "maxItems": 6
    },
    "ai": {
      "type": "string",
      "description": "\"random\" | \"smart\" | a rpg.hooks.ai name"
    },
    "items": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "reward": {
      "type": "integer",
      "minimum": 0
    },
    "reward_per_level": {
      "type": "integer",
      "minimum": 0
    },
    "intro": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "defeat": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "after": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "on_win": {
      "$ref": "common.json#/$defs/effects"
    },
    "music": {
      "type": "string"
    },
    "battle": {
      "$ref": "common.json#/$defs/battle_bg"
    }
  },
  "additionalProperties": false,
  "required": [
    "name",
    "party"
  ]
}
