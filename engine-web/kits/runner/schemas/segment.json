{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dreamsy/kits/runner/segment.json",
  "title": "data/segments/<id>.json \u2014 endless track segment",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "tier": {
      "type": "integer",
      "minimum": 0
    },
    "weight": {
      "type": "number"
    },
    "biomes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[.BJSCMHXG]+$"
      },
      "description": "one char per lane, nearest row first: . B(block) J(low: jump) S(high: slide) C(coin) G(gem) M(magnet) H(shield) X(2x)"
    }
  },
  "additionalProperties": false,
  "required": [
    "tier",
    "rows"
  ]
}