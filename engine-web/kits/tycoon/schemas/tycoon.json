{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dreamsy://kits/tycoon/tycoon.json",
  "title": "data/tycoon.json \u2014 tycoon kit config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "currencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "name": {
            "type": "string"
          },
          "icon": {
            "type": "string",
            "pattern": "^asset:[a-z][a-z0-9_]*$"
          },
          "start": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "description": "first = main currency unless `main` is set"
    },
    "main": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "tap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "rate_fraction": {
          "type": "number",
          "minimum": 0,
          "description": "tap also pays this fraction of 1 s of income"
        }
      }
    },
    "offline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cap_hours": {
          "type": "number",
          "minimum": 0
        },
        "rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "mult"
        ],
        "properties": {
          "at": {
            "type": "integer",
            "minimum": 1
          },
          "mult": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "kind": {
            "enum": [
              "output",
              "speed"
            ]
          },
          "target": {
            "type": "string",
            "description": "\"all\" or a generator id"
          }
        }
      },
      "description": "default milestones for every generator"
    },
    "prestige": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "currency"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "name": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "threshold": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "exponent": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "scale": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "bonus": {
            "type": "number",
            "minimum": 0,
            "description": "output +bonus per prestige unit"
          },
          "bonus_on": {
            "enum": [
              "earned",
              "held"
            ]
          },
          "min_gain": {
            "type": "number",
            "minimum": 1
          },
          "keep_managers": {
            "type": "boolean"
          },
          "resets": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "description": "currencies reset to start (default: all non-prestige currencies)"
          },
          "resets_layers": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          }
        }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "first_delay": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}