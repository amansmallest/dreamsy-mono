{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "debug",
      "displayName": "Debug + ASan/UBSan",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DREAMSY_SANITIZE": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "headless",
      "displayName": "Debug + sanitizers, no player (CI on Linux without a display stack)",
      "inherits": "debug",
      "cacheVariables": {
        "DREAMSY_BUILD_PLAYER": "OFF"
      }
    },
    {
      "name": "web",
      "displayName": "Web (Emscripten, release)",
      "inherits": "base",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ios-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "16.0"
      }
    },
    {
      "name": "ios-sim",
      "displayName": "iOS Simulator (arm64, Ninja; runs unsigned in the simulator)",
      "inherits": "ios-base",
      "cacheVariables": {
        "CMAKE_OSX_SYSROOT": "iphonesimulator",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "ios-device",
      "displayName": "iPhone/iPad (arm64, Xcode project; signing in Xcode)",
      "inherits": "ios-base",
      "generator": "Xcode",
      "cacheVariables": {
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "DREAMSY_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "android-arm64",
      "displayName": "Android arm64-v8a (NDK; needs ANDROID_NDK_HOME)",
      "inherits": "base",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-26",
        "ANDROID_STL": "c++_static",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "headless",
      "configurePreset": "headless"
    },
    {
      "name": "web",
      "configurePreset": "web"
    },
    {
      "name": "ios-sim",
      "configurePreset": "ios-sim"
    },
    {
      "name": "ios-device",
      "configurePreset": "ios-device",
      "configuration": "Release",
      "targets": [
        "dreamsy-player"
      ]
    },
    {
      "name": "android-arm64",
      "configurePreset": "android-arm64"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "headless",
      "configurePreset": "headless",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "web",
      "configurePreset": "web",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ios-sim",
      "configurePreset": "ios-sim",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
