# Generates a C++ source that embeds format/catalog.json and the kit manifests
# (engine-web/kits/<kit>/kit.json) so the engine needs no data files at runtime.
#   cmake -DCATALOG=<catalog.json> -DKITS_DIR=<engine-web/kits> -DOUT=<file.cpp> -P embed_data.cmake

function(to_hex_array content out_var)
  string(HEX "${content}" hex)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  string(REGEX REPLACE "(0x[0-9a-f][0-9a-f],){32}" "\\0\n" hex "${hex}")
  set(${out_var} "${hex}" PARENT_SCOPE)
endfunction()

file(READ "${CATALOG}" catalog)

file(GLOB kit_files "${KITS_DIR}/*/kit.json")
list(SORT kit_files)
set(kits "{")
set(sep "")
foreach(f IN LISTS kit_files)
  get_filename_component(dir "${f}" DIRECTORY)
  get_filename_component(name "${dir}" NAME)
  if(name MATCHES "^_")  # _template
    continue()
  endif()
  file(READ "${f}" body)
  string(APPEND kits "${sep}\"${name}\": ${body}")
  set(sep ",\n")
endforeach()
string(APPEND kits "}")

to_hex_array("${catalog}" catalog_hex)
to_hex_array("${kits}" kits_hex)

set(src "// Generated by engine/cmake/embed_data.cmake. Do not edit.
#include \"pkg/embedded.h\"

namespace dreamsy::pkg::embedded {
namespace {
const unsigned char kCatalog[] = {
${catalog_hex}};
const unsigned char kKits[] = {
${kits_hex}};
}  // namespace

std::string_view catalog_json() { return {reinterpret_cast<const char*>(kCatalog), sizeof kCatalog}; }
std::string_view kits_json() { return {reinterpret_cast<const char*>(kKits), sizeof kKits}; }

}  // namespace dreamsy::pkg::embedded
")

# Only touch the file when the content changes, to avoid needless rebuilds.
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
  if(old STREQUAL src)
    return()
  endif()
endif()
file(WRITE "${OUT}" "${src}")
