# Generates a C++ source that embeds binary files as byte arrays (default fonts).
#   cmake -DFILES="a.ttf|b.ttf" -DNAMESPACE=dreamsy::render::embedded -DOUT=<file.cpp> -P embed_files.cmake
# The generated file defines, in NAMESPACE:
#   std::span<const uint8_t> file_data(size_t index);   // in the order of FILES
#   size_t file_count();

string(REPLACE "|" ";" FILES "${FILES}")
set(arrays "")
set(entries "")
set(i 0)
foreach(f IN LISTS FILES)
  file(READ "${f}" hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  string(REGEX REPLACE "(0x[0-9a-f][0-9a-f],){32}" "\\0\n" hex "${hex}")
  get_filename_component(name "${f}" NAME)
  string(APPEND arrays "// ${name}\nconst uint8_t kFile${i}[] = {\n${hex}};\n")
  string(APPEND entries "    std::span<const uint8_t>(kFile${i}, sizeof kFile${i}),\n")
  math(EXPR i "${i} + 1")
endforeach()

set(src "// Generated by engine/cmake/embed_files.cmake. Do not edit.
#include <cstddef>
#include <cstdint>
#include <span>

namespace ${NAMESPACE} {
namespace {
${arrays}
const std::span<const uint8_t> kFiles[] = {
${entries}};
}  // namespace

size_t file_count() { return sizeof kFiles / sizeof kFiles[0]; }
std::span<const uint8_t> file_data(size_t index) { return index < file_count() ? kFiles[index] : std::span<const uint8_t>(); }

}  // namespace ${NAMESPACE}
")

if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
  if(old STREQUAL src)
    return()
  endif()
endif()
file(WRITE "${OUT}" "${src}")
