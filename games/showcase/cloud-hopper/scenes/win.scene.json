        "color": "#ffffff"
      }
    },
    "win_menu": {
      "type": "UIButton",
      "props": {
        "anchor": "center",
        "offset": [
          0,
          430
        ],
        "size": [
          320,
          80
        ],
        "text": "Title",
        "font_size": 32,
        "background": "#3a5fa0",
        "color": "#ffffff"
