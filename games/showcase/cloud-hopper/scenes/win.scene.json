        "text": "You did it!",
        "font_size": 96,
        "font": "bold",
        "align": "center",
        "color": "#ffd84a",
        "outline": "#2b2140",
        "outline_size": 10
      }
    },
    "win_sub": {
      "type": "UIText",
      "props": {
        "anchor": "top",
        "offset": [
          0,
          250
        ],
        "size": [
          700,
          60
        ],
        "text": "Pip crossed the whole sky!",
        "font_size": 34,
        "align": "center",
        "color": "#ffffff",
        "outline": "#1d3a6b",
        "outline_size": 5
      }
    },
    "win_gems": {
      "type": "UIText",
