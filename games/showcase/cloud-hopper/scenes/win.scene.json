{
  "format": "0",
  "root": "win_root",
  "entities": {
    "win_root": {
      "type": "Node2D",
      "scripts": [
        "scripts/client/win.luau"
      ],
      "children": [
        "win_world",
        "win_camera",
        "win_title",
        "win_sub",
        "win_gems",
        "win_again",
        "win_menu"
      ]
    },
    "win_world": {
      "type": "Node2D"
    },
