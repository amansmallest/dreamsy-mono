{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dreamsy:kit/platformer/boss",
  "title": "platformer boss (data/bosses/<id>.json)",
  "type": "object",
  "required": ["id", "hp", "phases"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "name": { "type": "string", "description": "Shown on the boss bar." },
    "sprite": { "type": "string" }, "animset": { "type": "string" }, "anims": { "type": "object" },
    "faces": { "enum": ["left", "right"] },
    "hp": { "type": "number", "minimum": 1 },
    "size": { "$ref": "#/definitions/vec2" }, "draw_size": { "$ref": "#/definitions/vec2" },
    "damage": { "type": "number" }, "gravity": { "type": "number" }, "max_fall": { "type": "number" },
    "stompable": { "type": "boolean" }, "shootable": { "type": "boolean" }, "stomp_damage": { "type": "number" },
    "iframes": { "type": "number", "description": "Invulnerable seconds after each hit." },
    "needs_vulnerable": { "type": "boolean", "description": "Only takes damage during \"vulnerable\" steps." },
    "phases": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["steps"], "additionalProperties": false, "properties": {
        "until": { "type": "number", "minimum": 0, "maximum": 1, "description": "This phase lasts while hp/max > until; last phase uses 0." },
        "speed_mult": { "type": "number" },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/step" } } } }
    }
  },
  "definitions": {
    "vec2": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
    "step": { "type": "object", "required": ["do"], "properties": {
      "do": { "enum": ["wait", "face", "walk", "charge", "jump", "move", "land", "shoot", "summon", "vulnerable", "anim"] },
      "time": { "type": "number" }, "speed": { "type": "number" }, "toward": { "enum": ["player", "home", "left", "right", "turn"] },
      "windup": { "type": "number" }, "height": { "type": "number" }, "distance": { "type": "number" },
      "to": { "oneOf": [{ "const": "player" }, { "$ref": "#/definitions/vec2" }] }, "above": { "type": "number" },
      "count": { "type": "integer" }, "spread": { "type": "number" }, "volleys": { "type": "integer" }, "interval": { "type": "number" },
      "aim": { "enum": ["player", "facing", "fixed"] }, "angle": { "type": "number" }, "after": { "type": "number" },
      "size": { "$ref": "#/definitions/vec2" }, "gravity": { "type": "number" }, "sprite": { "type": "string" },
      "enemy": { "type": "string" }, "gap": { "type": "number" }, "name": { "type": "string" } } }
  }
}
