{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dreamsy/kits/loot.json",
  "title": "Loot table (data/loot/<id>.json)",
  "description": "Weighted entries rolled `rolls` times; `rarities` picks a tier first; `guaranteed` always drops; `pity` forces >= rarity after N misses (state kept by the caller). No paid randomness: loot is gameplay-only.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "rolls": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "item": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "table": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "nothing": {
            "type": "boolean"
          },
          "weight": {
            "type": "number",
            "minimum": 0
          },
          "count": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2
              }
            ]
          },
          "rarity": {
            "type": "string",
            "enum": [
              "common",
              "uncommon",
              "rare",
              "epic",
              "legendary"
            ]
          },
          "chance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "oneOf": [
          {
            "required": [
              "item"
            ]
          },
          {
            "required": [
              "table"
            ]
          },
          {
            "required": [
              "nothing"
            ]
          }
        ]
      }
    },
    "guaranteed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "item": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "table": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "nothing": {
            "type": "boolean"
          },
          "weight": {
            "type": "number",
            "minimum": 0
          },
          "count": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2
              }
            ]
          },
          "rarity": {
            "type": "string",
            "enum": [
              "common",
              "uncommon",
              "rare",
              "epic",
              "legendary"
            ]
          },
          "chance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "oneOf": [
          {
            "required": [
              "item"
            ]
          },
          {
            "required": [
              "table"
            ]
          },
          {
            "required": [
              "nothing"
            ]
          }
        ]
      }
    },
    "rarities": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "common",
          "uncommon",
          "rare",
          "epic",
          "legendary"
        ]
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "pity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rarity",
        "after"
      ],
      "properties": {
        "rarity": {
          "type": "string",
          "enum": [
            "common",
            "uncommon",
            "rare",
            "epic",
            "legendary"
          ]
        },
        "after": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "required": [
    "entries"
  ]
}
