{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dreamsy/kits/procgen/words.json",
  "title": "Word lists (data/words/<id>.json) for procgen.names (markov training names, fill templates)",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "syllables": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lists": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}
