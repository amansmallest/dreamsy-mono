{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "racing config (data/racing.json)",
  "type": "object",
  "properties": {
    "currency": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "points": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "prize": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "xp": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "upgrades": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "stat",
          "cost"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "order": {
            "type": "number"
          },
          "stat": {
            "type": "string"
          },
          "pct": {
            "type": "number"
          },
          "add": {
            "type": "number"
          },
          "levels": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "cost": {
            "type": "object",
            "required": [
              "base"
            ],
            "properties": {
              "base": {
                "type": "number",
                "minimum": 0
              },
              "growth": {
                "type": "number",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  }
}
