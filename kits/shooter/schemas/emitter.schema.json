{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "shooter emitter (data/emitters/<id>.json)",
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "pattern": {
   "enum": [
    "aimed",
    "fan",
    "ring",
    "spiral",
    "wave",
    "line"
   ]
  },
  "count": {
   "type": "integer",
   "minimum": 1,
   "maximum": 64
  },
  "spread": {
   "type": "number"
  },
  "angle": {
   "type": "number"
  },
  "aim": {
   "type": "boolean"
  },
  "spin": {
   "type": "number"
  },
  "spinPerVolley": {
   "type": "number"
  },
  "waveAmp": {
   "type": "number"
  },
  "waveFreq": {
   "type": "number"
  },
  "rate": {
   "type": "number",
   "exclusiveMinimum": 0
  },
  "burst": {
   "type": "integer",
   "minimum": 1
  },
  "burstGap": {
   "type": "number"
  },
  "delay": {
   "type": "number"
  },
  "duration": {
   "type": "number"
  },
  "volleys": {
   "type": "integer"
  },
  "speed": {
   "type": "number"
  },
  "speedStep": {
   "type": "number"
  },
  "offset": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "minItems": 2,
   "maxItems": 2
  },
  "bullet": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "sprite": {
     "type": "string",
     "pattern": "^asset:[a-z0-9_]+$"
    },
    "color": {
     "type": "string",
     "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
    },
    "size": {
     "type": "array",
     "items": {
      "type": "number"
     },
     "minItems": 2,
     "maxItems": 2
    },
    "radius": {
     "type": "number"
    },
    "damage": {
     "type": "number"
    },
    "lifetime": {
     "type": "number"
    },
    "rotate": {
     "type": "boolean"
    },
    "speed": {
     "type": "number"
    },
    "accel": {
     "type": "number"
    },
    "minSpeed": {
     "type": "number"
    },
    "maxSpeed": {
     "type": "number"
    },
    "speedCurve": {
     "type": "array",
     "items": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
     },
     "minItems": 1
    },
    "turn": {
     "type": "number"
    },
    "turnAfter": {
     "type": "number"
    },
    "angleCurve": {
     "type": "array",
     "items": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
     },
     "minItems": 1
    },
    "waveAmp": {
     "type": "number"
    },
    "waveFreq": {
     "type": "number"
    }
   }
  }
 },
 "required": [
  "pattern"
 ]
}