{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dreamsy:kit/topdown/boss",
  "title": "topdown boss (data/bosses/<id>.json)",
  "type": "object",
  "required": ["id", "hp", "phases"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "name": { "type": "string" }, "sprite": { "type": "string" }, "animset": { "type": "string" }, "anims": { "type": "object" },
    "size": { "$ref": "#/definitions/vec2" }, "draw_size": { "$ref": "#/definitions/vec2" },
    "hp": { "type": "number", "minimum": 1 }, "damage": { "type": "number" }, "speed": { "type": "number" },
    "iframes": { "type": "number" }, "needs_vulnerable": { "type": "boolean" }, "flying": { "type": "boolean" },
    "phases": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["steps"], "additionalProperties": false, "properties": {
      "until": { "type": "number", "minimum": 0, "maximum": 1 }, "speed_mult": { "type": "number" },
      "steps": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["do"], "properties": {
        "do": { "enum": ["wait", "move", "teleport", "chase", "charge", "shoot", "summon", "vulnerable"] },
        "time": { "type": "number" }, "speed": { "type": "number" }, "windup": { "type": "number" },
        "to": { "oneOf": [{ "enum": ["player", "random", "home"] }, { "$ref": "#/definitions/vec2" }] }, "radius": { "type": "number" },
        "pattern": { "enum": ["ring", "aimed", "spread"] }, "count": { "type": "integer" }, "spread": { "type": "number" },
        "volleys": { "type": "integer" }, "interval": { "type": "number" }, "after": { "type": "number" }, "rotate": { "type": "number" },
        "size": { "$ref": "#/definitions/vec2" }, "life": { "type": "number" }, "sprite": { "type": "string" }, "enemy": { "type": "string" } } } } } } }
  },
  "definitions": { "vec2": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 } }
}
