{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tower-defense campaign (data/campaign.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "levels"
  ],
  "properties": {
    "start_towers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "locked_branches": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
      }
    },
    "stars": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "two": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "three": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level"
        ],
        "properties": {
          "level": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "requires_stars": {
            "type": "integer",
            "minimum": 0
          },
          "unlock": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "towers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              },
              "branches": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "endless": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level"
      ],
      "properties": {
        "level": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "waves": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "requires": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      }
    }
  }
}
