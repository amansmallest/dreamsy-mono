# Copy to services/api/.env (loaded automatically by the API, migrations, seed script and harness worker).
PORT=8787
# 0.0.0.0 = reachable from phones on the LAN (Expo Go + the engine WebView)
HOST=0.0.0.0
DATABASE_URL=postgres://dreamsy:dreamsy@localhost:5432/dreamsy
JWT_SECRET=change-me-at-least-32-characters-long
# Shared with the harness worker and scripts/seed-showcase.ts (they read WORKER_TOKEN too)
WORKER_TOKEN=change-me-worker-token
DAILY_GENERATION_QUOTA=50
# Stars every new wallet starts with; creator's share of each sale
STARTER_STARS=500
CREATOR_SHARE=0.5
# Empty = allow any origin (the engine page on http://<mac-lan-ip>:2005 calls the API). Comma-separated to restrict.
CORS_ORIGINS=
# comma-separated; Apple = iOS bundle id(s), Google = OAuth web client id(s).
# Not needed for Expo Go (guest sign-in only there).
APPLE_AUDIENCES=com.dreamsy.app
GOOGLE_AUDIENCES=
# Supabase Auth (Google sign-in in the app → POST /v1/auth/supabase). Sessions are verified against
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json; set SUPABASE_JWT_SECRET only for legacy HS256 projects.
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Dev: game packages + uploads stored on disk (default <repo>/.data/blobs). Set S3_BUCKET (+ S3_ENDPOINT, S3_REGION, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY) to use S3 instead.
# STORAGE_DIR=
